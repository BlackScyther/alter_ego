# Alter Ego server environment - copy to ops/server.env and fill in secrets.
#   cp ops/env.example ops/server.env
# ops/*.env is gitignored. In Coolify, set these as environment variables in
# the application UI instead of using this file.

# --- Network ---
# Port the Node server listens on (inside the container).
PORT=3000

# Comma-separated list of allowed CORS origins. Leave UNSET for the single
# container same-origin setup (frontend and API share one origin).
# CORS_ORIGIN=https://app.example.com

# Max API requests per minute per IP (static assets are never rate limited).
RATE_LIMIT_PER_MIN=120

# --- Single-container static hosting ---
# Directory of the built frontend served by the Node process.
STATIC_DIR=/app/dist/app
# Public data directory exposed at /data (compendium DB + samples ONLY).
PUBLIC_DATA_DIR=/data-public

# --- Databases ---
# Read-write application DB (campaigns, homebrew, feedback). Keep OUT of the
# public data dir so it is never served over HTTP.
DATABASE_PATH=/data-private/campaigns.db
# Read-only compendium DB (the ~77 MB alter_eger.db).
COMPENDIUM_DB_PATH=/data-public/alter_eger.db

# --- Public URLs (invite links) ---
# Public base URL of the deployed site, no trailing slash.
PUBLIC_APP_URL=https://app.example.com
# Path to the join page on the deployed site. Root-served production build uses
# /join/index.html; the legacy /src layout uses /src/join/index.html.
PUBLIC_JOIN_PATH=/join/index.html

# --- Secrets ---
# Random secret used to pepper hashed access tokens. Generate once and keep it
# stable, e.g.:  openssl rand -hex 32
TOKEN_PEPPER=change-me-to-a-long-random-string
