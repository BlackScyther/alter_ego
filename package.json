{
  "name": "alter-eger",
  "version": "1.0.0",
  "private": true,
  "description": "Alter Ego — offline D&D 4e compendium, character tools, and DM party surface",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:app": "vite build && node scripts/post-build-app.mjs",
    "pull:live": "node scripts/pull-live.mjs && node scripts/pull-live-data.mjs",
    "preview:live": "npx --yes serve sync-from-live -p 5173",
    "start": "npx --yes serve sync-from-live -p 5173",
    "dev:src": "vite",
    "start:legacy": "npx --yes serve . -p 5173",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "pdf": "node scripts/export-pdf.mjs",
    "pdf:levels": "node scripts/export-pdf.mjs --levels-only",
    "party:index": "node scripts/build-party-index.mjs",
    "pack:player": "node scripts/pack-player.mjs",
    "server": "node server/index.mjs",
    "dev:api": "node server/index.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "test:api": "node scripts/test-campaign-api.mjs",
    "test": "node --test tests/html-escape.test.mjs tests/validate-character.test.mjs tests/character-io.test.mjs tests/party-loader.test.mjs tests/api-security.test.mjs",
    "test:security": "node --test tests/html-escape.test.mjs tests/validate-character.test.mjs tests/character-io.test.mjs tests/party-loader.test.mjs tests/api-security.test.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "@tauri-apps/api": "^2.4.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.5",
    "@tauri-apps/cli": "^2.5.0",
    "playwright": "^1.52.0",
    "tailwindcss": "^4.1.5",
    "vite": "^6.3.5"
  }
}
